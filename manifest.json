{
  "manifest_version": 3,
  "name": "Diff Review — 変更をひとつずつ確認",
  "version": "1.0.0",
  "description": "diffを文脈とともに確認し、承認・否認・編集した結果から新しいdiffを作成します。すべて端末内で処理します。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Diff Review を開く",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}